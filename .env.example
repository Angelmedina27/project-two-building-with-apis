# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# TMDB v3 API key from https://www.themoviedb.org/settings/api
# The app starts without it; only TMDB search and saving need it.
TMDB_API_KEY=

# Optional: development defaults are used when these are unset.
# SECRET_KEY=change-me
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
