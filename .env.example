# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# TMDB v3 API key from https://www.themoviedb.org/settings/api
# The app starts without it; only TMDB search and saving need it.
TMDB_API_KEY=

# Used only by scripts/watchlist_update.py (the Django app ignores these).
# Get a token with the dev server running (use your own username and password):
#   curl -X POST http://127.0.0.1:8000/api/auth/token/ -d "username=alice" -d "password=your-password"
# and paste the "token" value here. Anyone with this token can change your watchlist.
CINEMOVTRACKER_API_TOKEN=
# Optional: where the API runs. Defaults to http://127.0.0.1:8000.
# CINEMOVTRACKER_API_URL=http://127.0.0.1:8000

# Optional: development defaults are used when these are unset.
# SECRET_KEY=change-me
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
